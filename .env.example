JEV_API_KEY=
JEV_BASE_URL=https://thejevai.com/v1/systemone
# Pin a versioned ID once known, e.g. jev-1.13.0
JEV_MODEL=jev-latest
# thejevai | typesafe | llm_fallback
JEV_PROVIDER=thejevai
# OpenAI tier used when JEV_PROVIDER=llm_fallback: fast | strong
JEV_FALLBACK_TIER=fast
# When the Jev provider fails: human | llm_fallback
JEV_ON_FAILURE=human
OPENAI_API_KEY=
# Cheap tier, set to a current model name
OPENAI_MODEL_FAST=
# Capable tier
OPENAI_MODEL_STRONG=
# Token prices for cost accounting
MODEL_TIERS_PATH=policies/model_tiers.yaml
# Confidence cutoffs per decision
THRESHOLDS_PATH=policies/thresholds.yaml
DATABASE_URL=sqlite:///./sentinel.db
LOG_LEVEL=INFO
