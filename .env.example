# vercel (official TypeSafe Jev via Vercel AI Gateway) | thejevai | typesafe | llm_fallback
JEV_PROVIDER=vercel
# Vercel AI Gateway. With a proxy-injected credential, set any non-empty placeholder.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v4/ai
JEV_GATEWAY_MODEL=typesafe-ai/jev
# thejevai.com reseller (fallback)
JEV_API_KEY=
JEV_BASE_URL=https://thejevai.com/v1/systemone
JEV_MODEL=jev-latest
# OpenAI tier used when JEV_PROVIDER=llm_fallback: fast | strong
JEV_FALLBACK_TIER=fast
# When the Jev provider fails: human | llm_fallback
JEV_ON_FAILURE=human
# Client-side cap on Jev requests/second (Vercel free tier throttles ~3 req/s)
JEV_MAX_RPS=2
# Circuit breaker: consecutive transient failures before failing fast, and cool-down
JEV_BREAKER_FAILURES=5
JEV_BREAKER_RESET_S=30
# HTTP API: max POST /items per minute (429 above)
API_MAX_ITEMS_PER_MINUTE=60
OPENAI_API_KEY=
# Cheap tier, set to a current model name
OPENAI_MODEL_FAST=
# Capable tier
OPENAI_MODEL_STRONG=
# Token prices for cost accounting
MODEL_TIERS_PATH=policies/model_tiers.yaml
# Confidence cutoffs per decision
THRESHOLDS_PATH=policies/thresholds.yaml
# Tool risk levels and approval rules
TOOLS_POLICY_PATH=policies/tools.yaml
DATABASE_URL=sqlite:///./sentinel.db
# Bearer token for the HTTP API (`sentinel serve`); required. Generate a long random value.
SENTINEL_API_TOKEN=
LOG_LEVEL=INFO
